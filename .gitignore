# .vhm preprocessor outputs (built by sim/Makefile or jcore-soc/tools)
core/datapath.vhd
core/mult.vhd
decode/decode_core.vhd
# Listed individually, NOT as cache/*.vhd: 23 of the .vhd files under cache/
# are hand-written and tracked (dcache.vhd, icache_ram.vhd, the *_tb.vhd
# benches, ...). A glob would read as "everything here is generated", and would
# silently swallow a genuinely new hand-written file. These six are the ones
# with a .vhm source, regenerated by sim/mmu_sim.sh and sim/linux_sim.sh on
# every run -- which is how they came to be sitting untracked in the first
# place, one `git add -A` away from being committed.
cache/dcache_ccl.vhd
cache/dcache_mcl.vhd
cache/icache_ccl.vhd
cache/icache_mcl.vhd
cache/icache_modereg.vhd
cache/icache_modereg_wsbu.vhd

# Generated by cpugen but consumed by sim/ — generated, not tracked
decode/sh2instr.c

# Makefile.inc's variants.mk fragment, generated from variants.toml
gen/
gen/variants.mk

# Testrom + sim/tests build artifacts
testrom/*.o
testrom/*.elf
testrom/*.img
testrom/*.map
sim/tests/*.o
sim/tests/*.elf
sim/tests/*.img
sim/tests/*.map
# ...and in subdirectories (e.g. sim/tests/dualcore/) — these .img/.elf are
# build artifacts regenerated from the tracked .s + Makefile, never committed.
sim/tests/**/*.o
sim/tests/**/*.elf
sim/tests/**/*.img
sim/tests/**/*.map

# Working/scratch files at repo root — not part of the build
insns.json
jcore-decoder-migration-spec-v2.md
docs/superpowers

# Git worktrees
.worktrees/
.superpowers/

# synth/ build artifacts (netlists, GHDL work dirs)
build/

# Python bytecode (synth/ metrics scripts + tests)
__pycache__/
*.pyc

# Editor / OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.o
*.a
